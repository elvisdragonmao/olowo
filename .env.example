# Copy to .env (git-ignored). Read by `docker compose`.
POSTGRES_PASSWORD=olowo
# 64 hex characters: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=
# Mapbox public token (pk.*), baked into the web bundle at build time.
VITE_MAPBOX_ACCESS_TOKEN=
# Public URL riders open; used for CORS. With a domain, also set SITE_ADDRESS to it for automatic HTTPS.
PUBLIC_ORIGIN=http://localhost:8080
SITE_ADDRESS=:80
# Host ports bind to 127.0.0.1 unless HTTP_BIND says otherwise (e.g. 0.0.0.0 with HTTP_PORT=80, HTTPS_PORT=443).
# HTTP_BIND=127.0.0.1
# Optional operator token so signed-out visitors can read stations.
OLOO_ACCESS_TOKEN=
