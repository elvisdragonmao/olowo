PORT=8787
WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173
# Local dev against `docker compose up -d db`.
DATABASE_URL=postgres://olowo:olowo@127.0.0.1:5432/olowo
# 32-byte key encoded as 64 hexadecimal characters (openssl rand -hex 32). Required with DATABASE_URL.
SESSION_ENCRYPTION_KEY=
# Optional operator token: lets signed-out visitors read stations. Without it, riders sign in first.
# OLOO_ACCESS_TOKEN=
# OLOO_API_BASE_URL=https://looplus-api-staging.loopluscooter.com/nest/api
