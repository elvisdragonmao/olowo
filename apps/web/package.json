		"@radix-ui/react-icons": "1.3.2",
		"@tanstack/react-query": "^5.104.5",
		"@use-gesture/react": "10.3.1",
		"daisyui": "^5.7.50",
		"maplibre-gl": "^6.15.0",
		"motion": "12.42.2",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-map-gl": "^8.1.3",
		"tailwindcss": "^4.3.3",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@playwright/test": "1.61.1",
		"@tailwindcss/postcss": "^4.3.3",
