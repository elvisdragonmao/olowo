{
	"name": "oluwu",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -r --if-present build",
		"build:web": "pnpm --filter @oluwu/web build",
		"dev": "pnpm --parallel --filter './apps/*' dev",
		"dev:api": "pnpm --filter @oluwu/api dev",
		"dev:web": "pnpm --filter @oluwu/web dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"preinstall": "node scripts/enforce-pnpm.mjs",
		"prepare": "sh -c 'if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git config core.hooksPath .githooks; fi'",
		"research:har": "node scripts/research/summarize-har.mjs"
	},
	"devDependencies": {
		"prettier": "^3.9.10",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-packagejson": "^3.0.2"
	},
	"packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
